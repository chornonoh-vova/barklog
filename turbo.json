{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "DATABASE_URL",
        "VALKEY_URL",
        "IGDB_CLIENT_ID",
        "IGDB_CLIENT_SECRET",
        "SYNC_CRON",
        "SYNC_TZ"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "VALKEY_URL",
        "IGDB_CLIENT_ID",
        "IGDB_CLIENT_SECRET",
        "SYNC_CRON",
        "SYNC_TZ"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "PORT",
        "EXPO_PUBLIC_API_URL",
        "DATABASE_URL",
        "VALKEY_URL",
        "IGDB_CLIENT_ID",
        "IGDB_CLIENT_SECRET",
        "SYNC_CRON",
        "SYNC_TZ"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "DATABASE_URL",
        "VALKEY_URL",
        "IGDB_CLIENT_ID",
        "IGDB_CLIENT_SECRET",
        "SYNC_CRON",
        "SYNC_TZ"
      ]
    },
    "prebuild": {
      "cache": false
    }
  }
}
