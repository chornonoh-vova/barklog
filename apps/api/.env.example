PORT=3000

# Infrastructure (matches deps.compose.yaml)
DATABASE_URL=postgres://barklog:barklog@localhost:5432/barklog
VALKEY_URL=redis://localhost:6379

# Clerk — https://dashboard.clerk.com, API keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Signing secret for the user.deleted webhook endpoint. Clerk shows it on the
# endpoint's page under Webhooks. Per-instance: development and production
# have different endpoints and different secrets.
CLERK_WEBHOOK_SIGNING_SECRET=

# LogTape levels: trace | debug | info | warning | error | fatal
LOG_LEVEL=debug

# OpenAI — https://platform.openai.com, API keys
OPENAI_API_KEY=
# Optional. One of: gpt-5.4-mini | gpt-5.4-nano | gpt-5.4. Defaults to gpt-5.4-mini.
# IDENTIFY_MODEL=

# RevenueCat — https://app.revenuecat.com, Project settings
# The Authorization header value you set on the webhook in RevenueCat's dashboard.
REVENUECAT_WEBHOOK_SECRET=
# HMAC signing secret. RevenueCat shows it once, at creation or rotation.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Secret API key (v1), used to re-read a subscriber after a purchase.
REVENUECAT_API_KEY=

