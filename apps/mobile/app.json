{
  "expo": {
    "name": "Barklog",
    "slug": "barklog",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/icon/icon.png",
    "scheme": "barklog",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "icon": "./assets/icon/Barklog.icon",
      "supportsTablet": true,
      "bundleIdentifier": "gg.barklog.app",
      "associatedDomains": [
        "applinks:barklog.gg"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.gg.barklog.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-image",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1A3C",
          "image": "./assets/icon/splash.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1,
              "supportsText": true
            }
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "BacklogWidget",
              "displayName": "Barklog",
              "description": "Your Playing, Waiting, Completed or Abandoned games.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "contentMarginsDisabled": true,
                "initialLayout": "./src/widgets/backlog-widget.tsx",
                "configuration": {
                  "title": "Section",
                  "description": "Which part of your backlog to show.",
                  "parameters": {
                    "section": {
                      "title": "Section",
                      "type": "enum",
                      "default": "playing",
                      "values": [
                        { "name": "Playing", "value": "playing" },
                        { "name": "Waiting", "value": "waiting" },
                        { "name": "Completed", "value": "completed" },
                        { "name": "Abandoned", "value": "abandoned" }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "uk", "ru", "de", "es"]
          }
        }
      ],
      "expo-build-properties",
      "expo-image",
      "expo-status-bar",
      "@clerk/expo",
      "@clerk/expo-native-components",
      "./plugins/with-pods-uuid-collision-fix"
    ],
    "locales": {
      "en": "./locales/en.json",
      "uk": "./locales/uk.json",
      "ru": "./locales/ru.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "gg.barklog.app.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.gg.barklog.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "ecbf8c87-dc5d-4811-8be3-e5cf0c781705"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ecbf8c87-dc5d-4811-8be3-e5cf0c781705"
    },
    "android": {}
  }
}
