{
  "expo": {
    "name": "Barklog",
    "slug": "barklog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "barklog",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "icon": "./assets/icon/Barklog.icon",
      "supportsTablet": false,
      "bundleIdentifier": "gg.barklog.app",
      "associatedDomains": ["applinks:barklog.gg"],
      "entitlements": {
        "com.apple.security.application-groups": ["group.gg.barklog.app"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1A3C",
          "image": "./assets/icon/splash.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1,
              "supportsText": true
            }
          }
        }
      ],
      "@clerk/expo",
      "expo-image",
      "./plugins/with-pods-uuid-collision-fix"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "gg.barklog.app.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.gg.barklog.app"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "ecbf8c87-dc5d-4811-8be3-e5cf0c781705"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ecbf8c87-dc5d-4811-8be3-e5cf0c781705"
    },
    "android": {}
  }
}
