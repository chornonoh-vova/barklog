---
import type { Language } from "@repo/i18n";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2";
import { LANGUAGES } from "@repo/i18n";

import { APP_STORE_ID } from "../config";
import { homeAlternates, OG_LOCALE } from "../i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Off for pages that render in the system stack — a preload the page never
      uses is dead bytes plus a console warning, not a free head start. */
  preloadFonts?: boolean;
  /** Off for the 404 page, whose own URL is not a page: nginx answers /404/
      with a 404, so a canonical pointing there would name a dead address as the
      preferred one. */
  canonical?: boolean;
  /** Off for pages with no [data-reveal] elements — shipping the reveal
      script there would be dead bytes with nothing to observe. The legal
      pages rely on this staying false: they ship zero JavaScript, and a test
      asserts it. */
  motion?: boolean;
  /** The page's language; English for everything that is not a localized home page. */
  lang?: Language;
  /** On for the localized home pages only: they are the one page in five languages,
      so each names the others (and x-default, the English root) as alternates. */
  alternates?: boolean;
  /** JSON-LD objects, each written as a data block browsers never execute. */
  jsonLd?: object[];
}

const {
  title,
  description,
  preloadFonts = true,
  canonical = true,
  motion = false,
  lang = "en",
  alternates = false,
  jsonLd = [],
} = Astro.props;

const absolute = (pathname: string) => new URL(pathname, Astro.site).href;
const pageUrl = absolute(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} class="bg-ground text-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={pageUrl} />}
    {
      alternates &&
        homeAlternates().map(({ hreflang, path }) => (
          <link rel="alternate" hreflang={hreflang} href={absolute(path)} />
        ))
    }

    {/* Generated from the app's own icon (apps/mobile/assets/icon/icon.png),
        so a bookmark or a home-screen tile shows the same thing as the App
        Store listing. They live in public/ rather than going through
        astro:assets because these paths have to stay stable — a browser asks
        for /favicon.ico and an iOS home screen for /apple-touch-icon.png
        without being told, so a content hash would break both. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    {/* 180x180 and opaque, which is what iOS wants: it applies its own
        rounding, so a pre-rounded or transparent tile comes out wrong. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1a3c" />
    <meta name="apple-mobile-web-app-title" content="Barklog" />
    {/* The latin subset only. Fontsource ships five, each behind a
        unicode-range, and preloading a subset this page's copy never triggers
        would be dead bytes plus a console warning. Imported rather than
        hardcoded so the href carries Vite's content hash. crossorigin is
        required even same-origin: a font request is always CORS-mode, and
        without it the browser preloads the file twice. */}
    {preloadFonts && <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />}

    {/* Link previews. One text-free image serves every language. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Barklog" />
    <meta property="og:image" content={absolute("/og.jpg")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {
      alternates &&
        LANGUAGES.filter((locale) => locale !== lang).map((locale) => (
          <meta property="og:locale:alternate" content={OG_LOCALE[locale]} />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />

    {/* Safari on iOS draws its own GET/OPEN strip from this. It is Apple's
        UI, not a second badge. */}
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

    {
      jsonLd.map((item) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(item).replaceAll("<", "\\u003c")} />
      ))
    }
  </head>
  <body class="font-body antialiased">
    <slot />
    {/* A bare <script> in an .astro file is bundled by Astro into an external
        module, not inlined — test/output.test.ts's inline-script guard is
        what confirms that, and it's the reason the legal pages can omit
        script-src 'unsafe-inline' entirely in nginx's CSP. */}
    {motion && <script>import "../scripts/reveal.ts";</script>}
  </body>
</html>
