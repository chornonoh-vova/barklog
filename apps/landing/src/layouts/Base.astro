---
import archivo from "../assets/fonts/archivo-latin-variable.woff2";
import sourceSerif from "../assets/fonts/source-serif-4-latin-variable.woff2";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Off for pages that render in the system stack — a preload the page never
      uses is dead bytes plus a console warning, not a free head start. */
  preloadFonts?: boolean;
  /** Off for pages with no [data-reveal] elements — shipping the reveal
      script there would be dead bytes with nothing to observe. The legal
      pages rely on this staying false: they ship zero JavaScript, and a test
      asserts it. */
  motion?: boolean;
}

const { title, description, preloadFonts = true, motion = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-ground text-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {/* Same two files global.css declares @font-face for, imported here so the
        preload href carries Vite's content hash. crossorigin is required even
        same-origin: a font request is always CORS-mode, and without it the
        browser preloads the file twice. */}
    {
      preloadFonts && (
        <>
          <link rel="preload" as="font" type="font/woff2" href={archivo} crossorigin />
          <link rel="preload" as="font" type="font/woff2" href={sourceSerif} crossorigin />
        </>
      )
    }
  </head>
  <body class="font-body antialiased">
    <slot />
    {/* A bare <script> in an .astro file is bundled by Astro into an external
        module, not inlined — test/output.test.ts's inline-script guard is
        what confirms that, and it's the reason the legal pages can omit
        script-src 'unsafe-inline' entirely in nginx's CSP. */}
    {motion && <script>import "../scripts/reveal.ts";</script>}
  </body>
</html>
