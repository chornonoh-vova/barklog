---
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Off for pages that render in the system stack — a preload the page never
      uses is dead bytes plus a console warning, not a free head start. */
  preloadFonts?: boolean;
  /** Off for the 404 page, whose own URL is not a page: nginx answers /404/
      with a 404, so a canonical pointing there would name a dead address as the
      preferred one. */
  canonical?: boolean;
  /** Off for pages with no [data-reveal] elements — shipping the reveal
      script there would be dead bytes with nothing to observe. The legal
      pages rely on this staying false: they ship zero JavaScript, and a test
      asserts it. */
  motion?: boolean;
}

const { title, description, preloadFonts = true, canonical = true, motion = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-ground text-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}

    {/* Generated from the app's own icon (apps/mobile/assets/icon/icon.png),
        so a bookmark or a home-screen tile shows the same thing as the App
        Store listing. They live in public/ rather than going through
        astro:assets because these paths have to stay stable — a browser asks
        for /favicon.ico and an iOS home screen for /apple-touch-icon.png
        without being told, so a content hash would break both. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    {/* 180x180 and opaque, which is what iOS wants: it applies its own
        rounding, so a pre-rounded or transparent tile comes out wrong. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1a3c" />
    <meta name="apple-mobile-web-app-title" content="Barklog" />
    {/* The latin subset only. Fontsource ships five, each behind a
        unicode-range, and preloading a subset this page's copy never triggers
        would be dead bytes plus a console warning. Imported rather than
        hardcoded so the href carries Vite's content hash. crossorigin is
        required even same-origin: a font request is always CORS-mode, and
        without it the browser preloads the file twice. */}
    {preloadFonts && <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />}
  </head>
  <body class="font-body antialiased">
    <slot />
    {/* A bare <script> in an .astro file is bundled by Astro into an external
        module, not inlined — test/output.test.ts's inline-script guard is
        what confirms that, and it's the reason the legal pages can omit
        script-src 'unsafe-inline' entirely in nginx's CSP. */}
    {motion && <script>import "../scripts/reveal.ts";</script>}
  </body>
</html>
