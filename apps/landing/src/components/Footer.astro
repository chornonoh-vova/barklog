---
import { CONTACT_EMAIL } from "../config";
---

<footer class="border-t border-rule">
  <div
    class="mx-auto flex max-w-[70rem] flex-col gap-6 px-6 py-12 text-[0.9375rem] text-ink-muted md:px-10 sm:flex-row sm:items-start sm:justify-between"
  >
    <div>
      <p>Barklog, made by Volodymyr Chornonoh</p>
      {/* OFL 1.1 requires the licence to travel with the fonts this site serves. */}
      <p class="mt-2 text-sm">
        Set in Archivo and Source Serif 4, under the <a
          class="rounded-sm underline underline-offset-4 transition-colors hover:text-ink"
          href="/fonts/OFL.txt">SIL Open Font License</a
        >.
      </p>
    </div>
    <nav class="flex flex-wrap items-center gap-x-7 gap-y-2 font-display text-sm font-medium">
      <a class="rounded-sm transition-colors hover:text-ink" href="/terms">Terms</a>
      <a class="rounded-sm transition-colors hover:text-ink" href="/privacy">Privacy</a>
      <a class="rounded-sm transition-colors hover:text-ink" href={`mailto:${CONTACT_EMAIL}`}>
        {CONTACT_EMAIL}
      </a>
    </nav>
  </div>
</footer>
