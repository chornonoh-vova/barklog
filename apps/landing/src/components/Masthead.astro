---
import { Image } from "astro:assets";

import appIcon from "../assets/app-icon.png";
---

{/* A sibling of <main>, not a descendant: a <header> nested inside <main> is
    not a banner landmark, and the wordmark would be announced as page content.

    No App Store link here. Apple's marketing guidelines allow one App Store
    badge per layout, and the hero carries the real one — a second link would
    also compete with the badge it is meant to lead to. */}
<header class="border-b border-transparent">
  <div class="mx-auto flex max-w-[70rem] items-center px-6 py-7 md:px-10">
    <span class="flex items-center gap-3 font-display text-[1.0625rem] font-bold tracking-tight">
      {/* The real app icon, not a mark drawn for the web, so what people see
          here is what they tap in the App Store. Its artwork sits on the same
          navy as the page, so the ring is what gives the tile an edge —
          without it the dog appears to float. */}
      <Image
        class="h-12 w-12 rounded-[22%] ring-1 ring-rule"
        src={appIcon}
        alt=""
        width={64}
        height={64}
        densities={[1, 2]}
        loading="eager"
      />
      Barklog
    </span>
  </div>
</header>
