---
import type { Language } from "@repo/i18n";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import astroBot from "../assets/hero-covers/astro-bot.jpg";
import baldursGate from "../assets/hero-covers/baldurs-gate-iii.jpg";
import clairObscur from "../assets/hero-covers/clair-obscur-expedition-33.jpg";
import eldenRing from "../assets/hero-covers/elden-ring.jpg";
import godOfWar from "../assets/hero-covers/god-of-war.jpg";
import gta from "../assets/hero-covers/grand-theft-auto-vi.jpg";
import mascot from "../assets/mascot.webp";
import { copy } from "../i18n";
import AppStoreBadge from "./AppStoreBadge.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = copy(lang).hero;

/* The onboarding screen's composition (apps/mobile/src/features/onboarding/
   cover-hero.tsx): the same six covers (covers.ts, fetched once from IGDB at
   t_cover_big and committed, since the site makes no third-party requests),
   at the same centres and tilts. Written out as whole class names rather than
   built from numbers, because Tailwind only generates classes it can read in
   the source. The delays stagger the bob so the ring never moves in step. */
const COVERS: { image: ImageMetadata; place: string }[] = [
  { image: gta, place: "left-[17%] top-[17%] rotate-[-10deg]" },
  { image: eldenRing, place: "left-[83%] top-[15%] rotate-[9deg] [&>img]:[animation-delay:-2.3s]" },
  { image: clairObscur, place: "left-[7%] top-[52%] rotate-[7deg] [&>img]:[animation-delay:-4.1s]" },
  { image: baldursGate, place: "left-[93%] top-[50%] rotate-[-7deg] [&>img]:[animation-delay:-1.2s]" },
  { image: godOfWar, place: "left-[20%] top-[86%] rotate-[-6deg] [&>img]:[animation-delay:-3.4s]" },
  { image: astroBot, place: "left-[80%] top-[84%] rotate-[5deg] [&>img]:[animation-delay:-5.6s]" },
];
---

<section class="relative isolate">
  {/* Clipped by its own box so the glow reaches the top of the page without
      the section having to hide overflow. */}
  <div class="pointer-events-none absolute inset-x-0 -top-30 -z-10 h-[46rem] overflow-hidden">
    <div class="hero-glow absolute -top-40 left-1/2 h-[46rem] w-[70rem] -translate-x-1/2"></div>
  </div>

  <div class="mx-auto flex max-w-[70rem] flex-col items-center px-4 pt-2 pb-16 text-center sm:px-6 md:px-10 lg:pt-6 lg:pb-24">
    {/* Decorative: the headline below says what the page is. The ring is
        sized in global.css so short phones shrink it before the text. */}
    <div class="hero-ring relative" data-hero-ring aria-hidden="true">
      <Image
        class="absolute top-[40%] left-1/2 w-[43%] -translate-1/2"
        src={mascot}
        alt=""
        widths={[200, 320, 480]}
        sizes="(min-width: 1024px) 13rem, 43vw"
        loading="eager"
        fetchpriority="high"
      />
      {
        COVERS.map(({ image, place }) => (
          <span class:list={["absolute w-[14.5%] -translate-1/2", place]}>
            <Image
              class="hero-cover block aspect-[3/4] w-full rounded-[0.4rem] object-cover shadow-[0_10px_24px_-6px_rgba(0,0,0,0.7)] ring-1 ring-white/10"
              src={image}
              alt=""
              widths={[96, 160]}
              sizes="(min-width: 1024px) 5rem, 15vw"
              loading="eager"
            />
          </span>
        ))
      }
    </div>

    <h1
      class="mt-4 max-w-[16ch] font-display text-[clamp(2rem,6.4vw,4.4rem)] leading-[0.98] font-extrabold tracking-[-0.032em] text-balance"
    >
      {t.title}
    </h1>
    <p class="mt-4 max-w-[46ch] text-[1rem] leading-[1.5] text-ink-muted sm:text-[1.1875rem]">
      {t.subtitle}
    </p>
    {/* The badge's own p-2.5 is Apple's clear space; mt keeps the paragraph
        from crowding it further. */}
    <div class="mt-4">
      <AppStoreBadge lang={lang} />
    </div>
    <p class="text-[0.9375rem] text-ink-muted">{t.free}</p>
  </div>
</section>
