---
import { resources, type Language } from "@repo/i18n";

import explore from "../assets/screenshots/explore.png";
import gameDetails from "../assets/screenshots/game-details.png";
import shared from "../assets/screenshots/shared.png";
import widgets from "../assets/screenshots/widgets.png";
import { copy } from "../i18n";
import { homeJsonLd } from "../structured-data";
import Base from "../layouts/Base.astro";
import Faq from "./Faq.astro";
import Feature from "./Feature.astro";
import Footer from "./Footer.astro";
import Hero from "./Hero.astro";
import Masthead from "./Masthead.astro";
import Pricing from "./Pricing.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = copy(lang);
const app = resources[lang].app;

/** The four statuses, named and glossed by the app's own strings (status.* and
 * backlog.emptyFilter.*.description) rather than rewritten, so the page and the
 * app say the same thing in every language. The marks echo the SF Symbols in
 * features/game/format.ts: clock, gamecontroller, checkmark.seal, xmark.bin.
 * Abandoned is lit: it is the status other trackers leave out. */
const STATUSES = [
  {
    key: "waiting",
    marks: ["M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z", "M12 7.5V12l3 1.9"],
  },
  {
    key: "playing",
    marks: [
      "M8.8 8.5h6.4a4.8 4.8 0 0 1 4.7 5.8l-.4 1.9a2.5 2.5 0 0 1-4.4.9l-1.2-1.5h-3.8l-1.2 1.5a2.5 2.5 0 0 1-4.4-.9l-.4-1.9a4.8 4.8 0 0 1 4.7-5.8Z",
      "M7.9 11.6v2.5",
      "M6.65 12.85h2.5",
      "M15.8 12.4h.01",
      "M17.6 14h.01",
    ],
  },
  {
    key: "completed",
    marks: ["M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z", "M8.5 12.1 11 14.6l4.5-4.9"],
  },
  {
    key: "abandoned",
    marks: ["M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z", "M9.5 9.5 14.5 14.5", "M14.5 9.5 9.5 14.5"],
  },
] as const;
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={homeJsonLd(lang)}
  alternates
  motion
>
  <Masthead />

  <main>
    <Hero lang={lang} />

    {/* Share leads, as it leads the App Store listing. */}
    <Feature eyebrow={t.share.eyebrow} title={t.share.title} image={shared} alt={t.share.alt}>
      <p>{t.share.body}</p>
    </Feature>

    <Feature
      eyebrow={t.statuses.eyebrow}
      title={t.statuses.title}
      image={gameDetails}
      alt={t.statuses.alt}
      flip
    >
      <p>{t.statuses.body}</p>

      <dl class="mt-8 border-y border-rule">
        {
          STATUSES.map(({ key, marks }) => (
            <div class="grid gap-x-4 gap-y-1 border-t border-rule py-4 first:border-t-0 sm:grid-cols-[9.5rem_1fr] sm:items-baseline">
              <dt class="font-display text-[0.9375rem] leading-[1.55] font-semibold text-ink">
                {/* Inline, not a flex child: a flex container takes its baseline
                    from its first item, and an <svg> has none — which pushed the
                    status name off the gloss's baseline in the next column. */}
                <svg
                  class:list={[
                    "mr-2.5 inline-block h-[1.15rem] w-[1.15rem] align-[-0.27em]",
                    key === "abandoned" ? "text-accent-bright" : "text-ink-muted",
                  ]}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {marks.map((mark) => (
                    <path d={mark} />
                  ))}
                </svg>
                {app.status[key]}
              </dt>
              <dd class:list={["text-[0.9375rem] leading-[1.55]", key === "abandoned" && "text-ink"]}>
                {app.backlog.emptyFilter[key].description}
              </dd>
            </div>
          ))
        }
      </dl>
    </Feature>

    <Feature eyebrow={t.explore.eyebrow} title={t.explore.title} image={explore} alt={t.explore.alt}>
      <p>{t.explore.body}</p>
    </Feature>

    <Feature
      eyebrow={t.widgets.eyebrow}
      title={t.widgets.title}
      image={widgets}
      alt={t.widgets.alt}
      flip
    >
      <p>{t.widgets.body}</p>
    </Feature>

    <Pricing lang={lang} />

    <Faq lang={lang} />

    <section class="border-t border-rule" data-reveal>
      <div class="mx-auto max-w-[70rem] px-6 py-10 md:px-10">
        <p class="max-w-[58ch] text-[0.9375rem] leading-[1.6] text-ink-muted">
          {t.credit.before}<a
            class="rounded-sm text-accent-bright underline underline-offset-4"
            href="https://www.igdb.com"
            rel="noreferrer">{t.credit.link}</a
          >{t.credit.after}
        </p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Base>
