---
import type { Language } from "@repo/i18n";

import { copy } from "../i18n";

interface Props {
  lang: Language;
}

const t = copy(Astro.props.lang).extras;
---

{/* The smaller features, a line each: too slight for a screenshot section,
    still worth naming for someone deciding (and for search). */}
<section class="border-t border-rule py-16 md:py-20" data-reveal>
  <div class="mx-auto max-w-[70rem] px-6 md:px-10">
    <h2
      class="font-display text-[clamp(1.6rem,1rem+2vw,2.3rem)] leading-[1.08] font-bold tracking-[-0.02em]"
    >
      {t.title}
    </h2>
    <dl class="mt-8 grid grid-cols-1 gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        Object.values(t.items).map(({ title, body }) => (
          <div class="border-t border-rule pt-4">
            <dt class="font-display text-[1rem] font-semibold text-ink">{title}</dt>
            <dd class="mt-1 text-[0.9375rem] leading-[1.6] text-ink-muted">{body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
