---
import type { Language } from "@repo/i18n";

import { copy } from "../i18n";

interface Props {
  lang: Language;
}

const t = copy(Astro.props.lang).values;
---

{/* Three plain promises, each one the privacy policy or the app backs up. */}
<section class="border-t border-rule py-16 md:py-20" data-reveal>
  <div class="mx-auto max-w-[70rem] px-6 md:px-10">
    <h2 class="font-display text-sm font-semibold text-accent-bright">{t.title}</h2>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        Object.values(t.items).map(({ title, body }) => (
          <li class="rounded-2xl border border-rule bg-ground-raised p-6">
            <h3 class="font-display text-[1.125rem] font-bold text-ink">{title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-ink-muted">{body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
