---
import explore from "../assets/screenshots/explore.png";
import game from "../assets/screenshots/game.png";
import share from "../assets/screenshots/share.png";
import Feature from "../components/Feature.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Pricing from "../components/Pricing.astro";
import Base from "../layouts/Base.astro";

/** The four statuses, glossed in the app's own words — these lines are lifted
 * from apps/mobile/src/features/backlog/empty-states.ts rather than rewritten,
 * so the page and the app say the same thing. The marks echo the SF Symbols in
 * features/game/format.ts: clock, gamecontroller, checkmark.seal, xmark.bin. */
const STATUSES = [
  {
    name: "Waiting",
    gloss: "Games you mean to play, but haven't started.",
    marks: ["M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z", "M12 7.5V12l3 1.9"],
  },
  {
    name: "Playing",
    gloss: "Games you're in the middle of.",
    marks: [
      "M8.8 8.5h6.4a4.8 4.8 0 0 1 4.7 5.8l-.4 1.9a2.5 2.5 0 0 1-4.4.9l-1.2-1.5h-3.8l-1.2 1.5a2.5 2.5 0 0 1-4.4-.9l-.4-1.9a4.8 4.8 0 0 1 4.7-5.8Z",
      "M7.9 11.6v2.5",
      "M6.65 12.85h2.5",
      "M15.8 12.4h.01",
      "M17.6 14h.01",
    ],
  },
  {
    name: "Completed",
    gloss: "Games you saw all the way through.",
    marks: ["M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z", "M8.5 12.1 11 14.6l4.5-4.9"],
  },
  {
    name: "Abandoned",
    gloss: "Games you gave up on. No judgement.",
    marks: ["M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z", "M9.5 9.5 14.5 14.5", "M14.5 9.5 9.5 14.5"],
    lit: true,
  },
];
---

<Base
  title="Barklog — the games you meant to get back to"
  description="Barklog keeps your game backlog in one place: waiting, playing, completed, and abandoned. Free for ten unfinished games."
>
  <main>
    <Hero />

    <Feature
      eyebrow="Your backlog"
      title="Four honest statuses"
      image={game}
      alt="A game's detail screen in Barklog, showing its cover, platforms and summary above a control for setting the game's status."
    >
      <p>
        Waiting, playing, completed, abandoned. Most trackers assume you'll finish everything.
        Barklog doesn't. Abandoned is a real answer, and it's one tap away.
      </p>

      <dl class="mt-8 border-y border-rule">
        {
          STATUSES.map(({ name, gloss, marks, lit }) => (
            <div class="grid gap-x-4 gap-y-1 border-t border-rule py-4 first:border-t-0 sm:grid-cols-[9.5rem_1fr] sm:items-baseline">
              <dt class="font-display text-[0.9375rem] leading-[1.55] font-semibold text-ink">
                {/* Inline, not a flex child: a flex container takes its baseline
                    from its first item, and an <svg> has none — which pushed the
                    status name off the gloss's baseline in the next column. */}
                <svg
                  class:list={[
                    "mr-2.5 inline-block h-[1.15rem] w-[1.15rem] align-[-0.27em]",
                    lit ? "text-accent-bright" : "text-ink-muted",
                  ]}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {marks.map((mark) => (
                    <path d={mark} />
                  ))}
                </svg>
                {name}
              </dt>
              <dd class:list={["text-[0.9375rem] leading-[1.55]", lit && "text-ink"]}>{gloss}</dd>
            </div>
          ))
        }
      </dl>
    </Feature>

    <Feature
      eyebrow="Explore"
      title="Find the next one"
      image={explore}
      alt="Barklog's explore screen: rows of game covers under headings for what's popular, what's coming, and what just landed, with a search field at the top."
      flip
    >
      <p>
        See what's popular, what's coming, and what just landed. Or search by name, when you already
        know. Tap a game for its platforms, its summary, and what it's similar to.
      </p>
    </Feature>

    <Feature
      eyebrow="Share a video"
      title="Share a video, get the game"
      image={share}
      alt="Barklog's share sheet result: a shared video at the top and, under it, the games it might be, each with its cover and release year, ready to pick."
    >
      <p>
        You're watching a clip of some game you can't name. Share it to Barklog and it works out
        which game that is, then hands you the matches to pick from. All it reads is the video's
        title and the channel name.
      </p>
    </Feature>

    <Pricing />

    <section class="border-t border-rule">
      <div class="mx-auto max-w-[70rem] px-6 py-10 md:px-10">
        <p class="max-w-[58ch] text-[0.9375rem] leading-[1.6] text-ink-muted">
          Every cover, release date, platform and summary comes from <a
            class="rounded-sm text-accent-bright underline underline-offset-4"
            href="https://www.igdb.com"
            rel="noreferrer">IGDB</a
          >, a games database its community maintains.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>
