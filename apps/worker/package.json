    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
