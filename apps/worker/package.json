{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync": "tsx --env-file=.env src/cli.ts",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:",
    "@repo/cache": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/igdb": "workspace:*",
    "@repo/logging": "workspace:*",
    "drizzle-orm": "catalog:",
    "node-cron": "^4.6.0",
    "pg": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
